# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# GOOGLE_MAPS_PLATFORM_KEY: Required for interactive Google Maps route rendering.
# Get your API key from Google Cloud Console: https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_PLATFORM_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# ADMIN_PIN: Security PIN for the Owner Admin Console (Default: 1750).
ADMIN_PIN="1750"

# APP_URL: The URL where this applet is hosted.
APP_URL="YOUR_APP_URL"

