  "faqs": [
    {
      "id": "faq-1",
      "category": "Permits & Documents",
      "question": "How do I get permits for Nathula Pass and North Sikkim?",
      "answer": "OffbeatDestination Travels handles 100% of your permit processing with the Sikkim Tourism & Army authorities. You simply need to email or WhatsApp us copies of your Voter ID / Passport and 2 passport photos at least 24-48 hours before travel.",
      "active": true,
      "order": 1
    },
    {
      "id": "faq-2",
      "category": "Cab & Transport",
      "question": "Are all cab transfers private or on a sharing basis?",
      "answer": "Our primary packages feature 100% private luxury vehicles (Innova Crysta, Xylo, Scorpio) dedicated solely to your family or group. We also offer fixed-departure shared seats for budget travelers upon request.",
      "active": true,
      "order": 2
    },
    {
      "id": "faq-3",
      "category": "Hotels & Food",
      "question": "Is pure vegetarian or Jain food available during the trip?",
      "answer": "Yes! All our hotel partners in Gangtok, Darjeeling, and Pelling provide dedicated pure vegetarian, Jain, and Gujarati meal options upon prior request.",
      "active": true,
      "order": 3
    },
    {
      "id": "faq-4",
      "category": "Booking & Payments",
      "question": "What is the advance booking amount to confirm our Sikkim trip?",
      "answer": "You can confirm your booking with a nominal 20% advance token payment. The remaining balance can be settled upon arrival at Gangtok hotel during briefing.",
      "active": true,
      "order": 4
    }
